<!-- Shared design tokens. Change values here rather than inside the layout. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Palette: brand, surfaces, feedback states and diagnostics. -->
  <Color x:Key="BrandColor">#115E67</Color>
  <Color x:Key="AccentColor">#E09C37</Color>
  <Color x:Key="AppBackgroundColor">#F3F7F6</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceSoftColor">#F7FAFA</Color>
  <Color x:Key="SurfaceMutedColor">#EDF4F3</Color>
  <Color x:Key="TextColor">#182326</Color>
  <Color x:Key="TextMutedColor">#5D6F73</Color>
  <Color x:Key="BorderSoftColor">#D7E3E1</Color>
  <Color x:Key="BorderStrongColor">#AFC4C1</Color>
  <Color x:Key="PrimaryHoverColor">#0E4F57</Color>
  <Color x:Key="PrimaryPressedColor">#0A3E45</Color>
  <Color x:Key="PrimarySoftColor">#DCEDEE</Color>
  <Color x:Key="FocusSoftColor">#FFF2D7</Color>
  <Color x:Key="DangerColor">#A33A3A</Color>
  <Color x:Key="DangerHoverColor">#842F2F</Color>
  <Color x:Key="SuccessColor">#2E7D59</Color>
  <Color x:Key="WarningColor">#A65E12</Color>
  <Color x:Key="RunningColor">#226C9B</Color>
  <Color x:Key="ConsoleBackgroundColor">#101719</Color>
  <Color x:Key="ConsoleTextColor">#DDE7E6</Color>
  <Color x:Key="ShadowColor">#26000000</Color>
  <!-- WPF brushes reference the palette above. -->
  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}"/>
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderSoftColor}"/>
  <SolidColorBrush x:Key="BorderBrushStrong" Color="{StaticResource BorderStrongColor}"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
  <SolidColorBrush x:Key="FocusSoftBrush" Color="{StaticResource FocusSoftColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="RunningBrush" Color="{StaticResource RunningColor}"/>
  <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="{StaticResource ConsoleBackgroundColor}"/>
  <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleTextColor}"/>
  <!-- Font families and icon fallback fonts. -->
  <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>
  <!-- Spacing scale used by reusable styles. -->
  <Thickness x:Key="Space0">0</Thickness>
  <Thickness x:Key="Space1">4</Thickness>
  <Thickness x:Key="Space2">8</Thickness>
  <Thickness x:Key="Space3">12</Thickness>
  <Thickness x:Key="Space4">16</Thickness>
  <Thickness x:Key="Space5">20</Thickness>
  <Thickness x:Key="Space6">24</Thickness>
  <Thickness x:Key="Space8">32</Thickness>
  <!-- Corner radii for cards, controls and badges. -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <!-- Typography sizes and line heights. -->
  <sys:Double x:Key="FontSizeCaption">12</sys:Double>
  <sys:Double x:Key="FontSizeSmall">13</sys:Double>
  <sys:Double x:Key="FontSizeBody">14</sys:Double>
  <sys:Double x:Key="FontSizeBodyLarge">15</sys:Double>
  <sys:Double x:Key="FontSizeTitle">24</sys:Double>
  <sys:Double x:Key="FontSizeDisplay">28</sys:Double>
  <sys:Double x:Key="LineCaption">16</sys:Double>
  <sys:Double x:Key="LineSmall">18</sys:Double>
  <sys:Double x:Key="LineBody">22</sys:Double>
  <sys:Double x:Key="LineBodyLarge">24</sys:Double>
  <sys:Double x:Key="LineTitle">30</sys:Double>
  <sys:Double x:Key="LineDisplay">34</sys:Double>
  <!-- Minimum control size and navigation column width. -->
  <sys:Double x:Key="TargetSize">44</sys:Double>
  <!-- Resource values must match the target property type; column Width uses GridLength. -->
  <GridLength x:Key="NavigationWidth">284</GridLength>
</ResourceDictionary>
