<!-- Main window layout. Named controls are bound by Update-Assistent.ps1. -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WFW Update-Assistent"
    Width="1160"
    Height="820"
    MinWidth="700"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBackgroundBrush}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="{DynamicResource FontSizeBody}"
    Foreground="{DynamicResource TextBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
  <!-- Window regions: header, navigation/content workspace, footer. -->
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- Header: company logo, application title and language selection. -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border
            Width="216"
            Height="78"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0"
            CornerRadius="{StaticResource RadiusMedium}"
            Padding="8">
          <Image
              x:Name="Logo"
              Stretch="Uniform"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
          <TextBlock
              x:Name="AppTitle"
              Text="Update-Assistent"
              FontFamily="{StaticResource DisplayFontFamily}"
              FontSize="{StaticResource FontSizeDisplay}"
              FontWeight="SemiBold"
              LineHeight="{StaticResource LineDisplay}"/>
          <TextBlock
              x:Name="AppSubtitle"
              Text="Schritt für Schritt durch die Updates – starten Sie links mit Schritt 1."
              Margin="0,4,0,0"
              FontSize="13"
              Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock
                x:Name="LanguageLabel"
                Text="Sprache"
                FontSize="{StaticResource FontSizeCaption}"
                FontWeight="Bold"
                Foreground="{StaticResource BrandBrush}"
                HorizontalAlignment="Right"/>
            <ComboBox
                x:Name="LanguageSwitch"
                Margin="0,4,0,0"
                AutomationProperties.Name="Sprache auswählen"
                SelectedIndex="0">
              <ComboBoxItem Tag="de" Content="Deutsch"/>
              <ComboBoxItem Tag="en" Content="English"/>
            </ComboBox>
          </StackPanel>
          <Border Style="{StaticResource Chip}" VerticalAlignment="Center">
            <TextBlock
                x:Name="SystemChip"
                Text="WINDOWS 11 PRO"
                Foreground="{StaticResource BrandBrush}"
                FontSize="{StaticResource FontSizeCaption}"
                FontWeight="Bold"
                LineHeight="{StaticResource LineCaption}"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <!-- Workspace: fixed-width step navigation and scrollable active-step content. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource NavigationWidth}"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,16">
            <TextBlock
                x:Name="ProgressLabel"
                Text="Fortschritt"
                FontSize="{StaticResource FontSizeCaption}"
                FontWeight="Bold"
                Foreground="{StaticResource BrandBrush}"
                LineHeight="{StaticResource LineCaption}"/>
            <TextBlock
                x:Name="ProgressText"
                Margin="0,5,0,0"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource MutedTextBrush}"
                LineHeight="{StaticResource LineSmall}"/>
            <ProgressBar
                x:Name="OverallProgress"
                Minimum="0"
                Maximum="8"
                Value="0"
                Margin="0,12,0,0"
                AutomationProperties.Name="Gesamtfortschritt"/>
          </StackPanel>
          <ListBox Grid.Row="1" x:Name="Navigation" AutomationProperties.Name="Bereiche und Bearbeitungsstatus"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border
              Background="{StaticResource SurfaceSoftBrush}"
              BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="0,0,0,1"
              CornerRadius="12,12,0,0"
              Padding="24,20">
            <StackPanel>
              <TextBlock
                  x:Name="SectionCounter"
                  Foreground="{StaticResource BrandBrush}"
                  FontWeight="Bold"
                  FontSize="{StaticResource FontSizeCaption}"
                  LineHeight="{StaticResource LineCaption}"/>
              <TextBlock
                  x:Name="StepTitle"
                  Margin="0,8,0,12"
                  FontFamily="{StaticResource DisplayFontFamily}"
                  FontSize="28"
                  FontWeight="SemiBold"
                  LineHeight="{StaticResource LineTitle}"/>
              <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,10,0,0">
                <TextBlock
                    x:Name="StepMode"
                    FontSize="{StaticResource FontSizeSmall}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrandBrush}"
                    LineHeight="{StaticResource LineSmall}"/>
              </Border>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22,24,24">
              <TextBlock FontSize="17" LineHeight="26" Margin="0,0,0,18" x:Name="StepIntro"/>
              <Expander Header="Schritt-für-Schritt-Anleitung" Margin="0,0,0,16" x:Name="Instructions">
                <TextBlock
                    x:Name="StepText"
                    FontSize="{StaticResource FontSizeBodyLarge}"
                    LineHeight="{StaticResource LineBodyLarge}"
                    Margin="0,12,0,4"/>
              </Expander>
              <!-- Action buttons are populated from the current step definition. -->
              <WrapPanel x:Name="Actions" Margin="0,0,0,8"/>
              <Expander Header="Weitere Möglichkeiten" Margin="0,0,0,16" x:Name="Alternatives">
                <WrapPanel Margin="0,12,0,0" x:Name="AdditionalActions"/>
              </Expander>
              <Border
                  Background="{StaticResource SurfaceSoftBrush}"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusMedium}"
                  Padding="16"
                  Margin="0,8,0,16">
                <StackPanel>
                  <TextBlock
                      x:Name="CurrentStatusLabel"
                      Text="Aktueller Stand"
                      FontSize="{StaticResource FontSizeCaption}"
                      FontWeight="Bold"
                      Foreground="{StaticResource BrandBrush}"
                      LineHeight="{StaticResource LineCaption}"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusIcon"
                        Text=""
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="18"
                        Width="28"
                        VerticalAlignment="Top"
                        Foreground="{StaticResource BrandBrush}"/>
                    <TextBlock
                        x:Name="Status"
                        FontWeight="SemiBold"
                        LineHeight="{StaticResource LineBody}"
                        AutomationProperties.LiveSetting="Polite"
                        Grid.Column="1"/>
                  </Grid>
                  <TextBlock
                      x:Name="NextActionLabel"
                      Text="Was mache ich als Nächstes?"
                      Margin="0,14,0,0"
                      FontWeight="SemiBold"/>
                  <TextBlock x:Name="NextHint" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                  <ProgressBar
                      x:Name="BusyBar"
                      IsIndeterminate="True"
                      Visibility="Collapsed"
                      Margin="0,12,0,0"
                      AutomationProperties.Name="Vorgang läuft"/>
                  <Button
                      x:Name="CancelRestart"
                      Content="Neustart verschieben"
                      Style="{StaticResource WarningButton}"
                      HorizontalAlignment="Left"
                      Visibility="Collapsed"
                      Margin="0,14,0,0"
                      AutomationProperties.Name="Neustart verschieben"/>
                </StackPanel>
              </Border>
              <!-- Manual completion is explicitly confirmed by the user. -->
              <CheckBox x:Name="Confirm" AutomationProperties.Name="Prüfung manuell bestätigen">
                <TextBlock
                    x:Name="ConfirmText"
                    Text="Ich habe die Prüfung im anderen Fenster abgeschlossen (auch wenn keine Updates angeboten wurden)."
                    Margin="6,0,0,0"
                    LineHeight="20"/>
              </CheckBox>
              <!-- Technical log output for the current operation. -->
              <Expander x:Name="Details" Header="Details zum Vorgang" Margin="0,0,0,16">
                <TextBox
                    x:Name="DetailText"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    Height="170"
                    VerticalScrollBarVisibility="Auto"
                    Margin="0,10,0,0"
                    AutomationProperties.Name="Technische Meldungen"/>
              </Expander>
              <Expander Header="Hilfe &amp; Dokumentation" Margin="0,0,0,16" x:Name="Support">
                <StackPanel>
                  <WrapPanel Margin="0,10,0,0">
                    <Button
                        x:Name="Guide"
                        Content="Ausführliche Anleitung (PDF)"
                        Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="Ausführliche Anleitung als PDF öffnen"/>
                    <Button
                        x:Name="Help"
                        Content="Hilfe zur Bedienung"
                        Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="Hilfe zur Bedienung"/>
                    <Button
                        x:Name="Report"
                        Content="Protokoll für IT"
                        Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="Protokoll für IT öffnen"/>
                  </WrapPanel>
                  <TextBlock
                      x:Name="HelpText"
                      Text="Anderes Fenster geöffnet? Kehren Sie über die Windows-Taskleiste zum Assistenten zurück. «Hilfe zur Bedienung» erklärt auch Fensterwechsel und Windows-Rückfragen."
                      FontSize="{StaticResource FontSizeSmall}"
                      Foreground="{StaticResource MutedTextBrush}"
                      LineHeight="{StaticResource LineSmall}"
                      Margin="0,10,0,0"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <!-- Footer: step navigation, documentation and local reports. -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,16,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button
              x:Name="Back"
              Content="Zurück"
              Style="{StaticResource SecondaryButton}"
              AutomationProperties.Name="Zurück"
              HorizontalAlignment="Left"/>
          <Button
              x:Name="Next"
              Content="Weiter"
              Style="{StaticResource PrimaryButton}"
              AutomationProperties.Name="Weiter"
              Grid.Column="1"
              Margin="0,0,0,8"/>
        </Grid>
        <TextBlock
            x:Name="FooterText"
            Grid.Row="1"
            Text="Ardawan Khosronezhad · IT Germany   |   Version 1.2 · Pilotfassung"
            FontSize="11"
            Foreground="{StaticResource MutedTextBrush}"
            LineHeight="16"
            Margin="2,2,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
